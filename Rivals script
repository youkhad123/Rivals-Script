local function setLine(f,x1,y1,x2,y2,thick,col)
	local dx,dy=x2-x1,y2-y1 local len=math.sqrt(dx*dx+dy*dy)
	if len<1 then f.Visible=false return end
	f.Size=UDim2.new(0,len,0,thick or 1) f.Position=UDim2.new(0,x1,0,y1)
	f.Rotation=math.deg(math.atan2(dy,dx)) if col then f.BackgroundColor3=col end f.Visible=true
end

local function usp()
	if not Cfg.E then
		for p in pairs(EC)do local c=EC[p] if c then
			if c.box then c.box.Visible=false end if c.hl then c.hl.Enabled=false end
			if c.nl then c.nl.Visible=false end if c.hpb then c.hpb.Visible=false end
			if c.dl then c.dl.Visible=false end if c.tr then c.tr.Visible=false end
			if c.skelLines then for _,l in ipairs(c.skelLines)do l.Visible=false end end
		end end return
	end
	for _,p in ipairs(PS:GetPlayers())do
		if p~=LP then
			local c=EC[p]
			if not c or c.ch~=p.Character then if p.Character and ghd(p)then bsp(p)c=EC[p]end end
			if c then
				local ch=p.Character local hrp=grp(p) local head=ghd(p) local dist=gdist(p)
				local vis=enemy(p)and ch and hrp and head and dist<=Cfg.EM
				if not vis then
					if c.box then c.box.Visible=false end if c.hl then c.hl.Enabled=false end
					if c.nl then c.nl.Visible=false end if c.hpb then c.hpb.Visible=false end
					if c.dl then c.dl.Visible=false end if c.tr then c.tr.Visible=false end
					if c.skelLines then for _,l in ipairs(c.skelLines)do l.Visible=false end end
				else
					local tp,ton=w2s(head.Position+Vector3.new(0,0.65,0))
					local bp,bon=w2s(hrp.Position-Vector3.new(0,3,0))
					if ton and bon then
						local h=math.abs(bp.Y-tp.Y) local w=h*0.55 local cx=(tp.X+bp.X)/2
						local bx=cx-w/2 local by=tp.Y
						if Cfg.EBOX then
							c.box.Visible=true c.box.Position=UDim2.new(0,bx,0,by) c.box.Size=UDim2.new(0,w,0,h)
							c.t.Position=UDim2.new(0,0,0,0) c.t.Size=UDim2.new(1,0,0,2)
							c.b.Position=UDim2.new(0,0,1,-2) c.b.Size=UDim2.new(1,0,0,2)
							c.l.Position=UDim2.new(0,0,0,0) c.l.Size=UDim2.new(0,2,1,0)
							c.r.Position=UDim2.new(1,-2,0,0) c.r.Size=UDim2.new(0,2,1,0)
							for _,co in ipairs(c.corners)do co.Parent=c.box end
						else c.box.Visible=false end
						if c.hl then c.hl.Enabled=Cfg.ECHAMS end
						if c.nl then c.nl.Visible=Cfg.EN if Cfg.EN then c.nl.Text=p.Name.." ["..math.floor(dist).."m]" c.nl.Size=UDim2.new(0,220,0,13) c.nl.Position=UDim2.new(0,cx-110,0,by-15) end end
						if c.hpb then c.hpb.Visible=Cfg.EH if Cfg.EH then
							local hum=ghum(p) local rat=hum and math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)or 1
							c.hpb.Size=UDim2.new(0,3,0,h) c.hpb.Position=UDim2.new(0,bx-6,0,by)
							c.hpf.Size=UDim2.new(1,0,rat,0) c.hpf.Position=UDim2.new(0,0,1-rat,0)
							c.hpf.BackgroundColor3=rat>0.6 and C.GREEN or rat>0.3 and C.YELLOW or C.RED
						end end
						if c.dl then c.dl.Visible=Cfg.ED if Cfg.ED then c.dl.Text=math.floor(dist).."m" c.dl.Size=UDim2.new(0,80,0,12) c.dl.Position=UDim2.new(0,cx-40,0,by+h+2) end end
						if c.tr then c.tr.Visible=Cfg.ETRACE if Cfg.ETRACE then
							local vp=CAM.ViewportSize local bx2,by2=bp.X,bp.Y local ox,oy=vp.X/2,vp.Y
							local dx2,dy2=bx2-ox,by2-oy local len=math.sqrt(dx2*dx2+dy2*dy2)
							c.tr.Size=UDim2.new(0,len,0,1) c.tr.Position=UDim2.new(0,ox,0,oy) c.tr.Rotation=math.deg(math.atan2(dy2,dx2))
						end end
						if Cfg.ESKEL and c.skelLines then
							for i,pair in ipairs(BONES)do
								local ln=c.skelLines[i]
								if ch then
									local p1=ch:FindFirstChild(pair[1]) local p2=ch:FindFirstChild(pair[2])
									if p1 and p2 then
										local s1,o1=w2s(p1.Position) local s2,o2=w2s(p2.Position)
										if o1 and o2 then setLine(ln,s1.X,s1.Y,s2.X,s2.Y,1,C.WHITE) else ln.Visible=false end
									else ln.Visible=false end
								else ln.Visible=false end
							end
						elseif c.skelLines then for _,l in ipairs(c.skelLines)do l.Visible=false end end
					end
				end
			end
		end
	end
end

