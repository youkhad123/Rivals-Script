local function strk(p,col,th)local s=Instance.new("UIStroke")s.Color=col or C.BORDER s.Thickness=th or 1 s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border s.Parent=p return s end
local function grad(p,c0,c1,r)local g=Instance.new("UIGradient")g.Color=ColorSequence.new(c0,c1)g.Rotation=r or 90 g.Parent=p return g end
local function w2s(pos)local s,o,z=CAM:WorldToViewportPoint(pos)return Vector2.new(s.X,s.Y),o,z end
local function enemy(p)
	if p==LP then return false end
	if not Cfg.ET then return true end
	local ok,v=pcall(function()if not LP.Team or not p.Team then return true end return p.Team~=LP.Team end)
	return ok and v or true
end
local function gc(p)return p and p.Character end
local function grp(p)local c=gc(p)return c and c:FindFirstChild("HumanoidRootPart")end
local function ghd(p)local c=gc(p)return c and c:FindFirstChild("Head")end
local function ghum(p)local c=gc(p)return c and c:FindFirstChildOfClass("Humanoid")end
local function gdist(p)local r=grp(p)if not r then return 99999 end return(r.Position-CAM.CFrame.Position).Magnitude end

