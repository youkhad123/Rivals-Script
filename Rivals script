-- AIMBOT
local function getBest()
	local vp=CAM.ViewportSize local ctr=Vector2.new(vp.X/2,vp.Y/2)
	local best,bd=nil,Cfg.AF
	for _,p in ipairs(PS:GetPlayers())do
		if p~=LP and enemy(p)and gdist(p)<=2000 then
			local ch=gc(p)
			local part=Cfg.AHS and(ch and ch:FindFirstChild("Head"))or(ch and ch:FindFirstChild("HumanoidRootPart"))
			if part then
				local sp,os,depth=w2s(part.Position)
				if os and depth>0 then local dd=(sp-ctr).Magnitude if dd<bd then bd=dd best=p end end
			end
		end
	end
	return best
end

local function doAim()
	if not Cfg.A then return end
	local t=getBest() if not t then return end
	safe(function()
		local ch=gc(t)
		local part=Cfg.AHS and(ch and ch:FindFirstChild("Head"))or(ch and ch:FindFirstChild("HumanoidRootPart"))
		if not part then return end
		local pos=part.Position
		if Cfg.AP then local hrp=grp(t) if hrp then pos=pos+hrp.AssemblyLinearVelocity*(gdist(t)/700)end end
		if Cfg.ASILENT then CAM.CFrame=CFrame.lookAt(CAM.CFrame.Position,pos)
		else local cf=CAM.CFrame CAM.CFrame=cf:Lerp(CFrame.lookAt(cf.Position,pos),1/math.max(Cfg.AS,1))end
	end)
end

local function doTrig()
	if not Cfg.ATRIG then return end
	safe(function()
		local t=getBest() if not t then return end
		local head=ghd(t) if not head then return end
		local sp,os,depth=w2s(head.Position)
		if not os or depth<=0 then return end
		local vp=CAM.ViewportSize local ctr=Vector2.new(vp.X/2,vp.Y/2)
		if(sp-ctr).Magnitude<25 then
			pcall(function()
				game:GetService("VirtualInputManager"):SendMouseButtonEvent(vp.X/2,vp.Y/2,0,true,game,0)
				task.wait(0.05)
				game:GetService("VirtualInputManager"):SendMouseButtonEvent(vp.X/2,vp.Y/2,0,false,game,0)
			end)
		end
	end)
end

-- FLY
local FBV,FC=nil,nil
local function startFly()
	local ch=LP.Character if not ch then return end
	local r=ch:FindFirstChild("HumanoidRootPart") local h=ch:FindFirstChildOfClass("Humanoid")
	if not r or not h then return end h.PlatformStand=true
	if FBV then FBV:Destroy()end
	FBV=Instance.new("BodyVelocity")FBV.MaxForce=Vector3.new(1e9,1e9,1e9)FBV.Velocity=Vector3.zero FBV.Parent=r
	if FC then FC:Disconnect()end
	FC=RS.RenderStepped:Connect(function()
		if not Cfg.FLY or not FBV or not FBV.Parent then return end
		local s=Cfg.FS local cf=CAM.CFrame local v=Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W)then v+=cf.LookVector*s end
		if UIS:IsKeyDown(Enum.KeyCode.S)then v-=cf.LookVector*s end
		if UIS:IsKeyDown(Enum.KeyCode.A)then v-=cf.RightVector*s end
		if UIS:IsKeyDown(Enum.KeyCode.D)then v+=cf.RightVector*s end
		if UIS:IsKeyDown(Enum.KeyCode.Space)then v+=Vector3.new(0,s,0)end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift)then v-=Vector3.new(0,s,0)end
		FBV.Velocity=v
	end)
end
local function stopFly()
	if FC then FC:Disconnect()FC=nil end if FBV then FBV:Destroy()FBV=nil end
	local ch=LP.Character if ch then local h=ch:FindFirstChildOfClass("Humanoid")if h then h.PlatformStand=false end end
end

